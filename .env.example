POLYESTER_API_KEY_ID=ak_your_key_id_here
POLYESTER_API_PRIVATE_KEY=your_64_char_ed25519_private_key_hex

# Subaccount-scoped keys need an attached API-key policy granting ledger reads
# (balances/private balance streams), plus trading permissions for mutations.
# This API-key policy is separate from, and intersects with, the subaccount policy.

# Account ID from Profile in the Polyester app (e.g. RLxqJGUDg92)
# Username is optional; Account ID auth/scoping is supported directly.
POLYESTER_ACCOUNT_ID=your_account_id_here

# Live test tiers (local only — not used in CI)
# POLYESTER_TEST_MUTATION=1
# POLYESTER_TEST_FUNDED=1
# Dedicated test accounts only; permits tests that use non-dry-run cancel_all:
# POLYESTER_TEST_ACCOUNT_WIDE_CLEANUP=1
# POLYESTER_TEST_TREASURY=1
# POLYESTER_TEST_TRADE_SYMBOL=BTC-USDT
# POLYESTER_TEST_MIN_TRADING_QUOTE=10
# POLYESTER_TEST_INTERNAL_TRANSFER_DEST=
# Funding→user is on-chain in the app; set unified for API-key internal_transfers smoke:
# POLYESTER_TEST_TRANSFER_SOURCE_BUCKET=unified
# POLYESTER_TEST_FUNDING_USER_TRANSFER_QTY=0.000001
# POLYESTER_TEST_SKIP_FUNDING_CHECK=1
# POLYESTER_TEST_TRADE_E2E=1
# Required for limit/market fill e2e (maker posts liquidity, taker account fills against it)
# POLYESTER_TEST_MAKER_API_KEY_ID=
# POLYESTER_TEST_MAKER_API_PRIVATE_KEY=
# POLYESTER_TEST_TRADE_PRICE=500000
# POLYESTER_TEST_TRADE_QTY=

# Legacy mutation alias
# POLYESTER_SMOKE_MUTATION=1

# Optional overrides (defaults to devnet)
# POLYESTER_API_URL=https://api-devnet.polyester.ai
# POLYESTER_WS_URL=wss://api-devnet.polyester.ai

# On-chain Funding UserOps — caller-supplied EOA, NOT the API ed25519 key
# and NOT a UI-exported "owner private key". SDK derives the Polyester Safe from this.
# POLYESTER_OWNER_PRIVATE_KEY=0x…   # throwaway testnet EOA that owns the Safe
# Safe must already have Funding uAsset balance for Funding→Trading / withdraw smoke.
# Public testnet RPC/bundler/paymaster are pinned in polyester.chain.POLYESTER_TESTNET_ENVIRONMENT.
# POLYESTER_TEST_CHAIN_USEROP=1
# POLYESTER_TEST_U_ASSET_ID=0x…     # Zipper catalog uAssetId (bytes32 hex); defaults to USDT
# POLYESTER_TEST_DEPOSIT_QTY_SCALED=1000000000000000000  # 1 USDT at 18-dec scale
# POLYESTER_TEST_WITHDRAW_CHAIN_ID=6
# POLYESTER_TEST_WITHDRAW_DESTINATION=0x…
# POLYESTER_TEST_WITHDRAW_AMOUNT=5

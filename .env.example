POLYESTER_API_KEY_ID=ak_your_key_id_here
POLYESTER_API_PRIVATE_KEY=your_64_char_ed25519_private_key_hex

# Profile account id (base58, e.g. RLxqJGUDg92) for LedgerWriteService.TransferFundToUnified.
POLYESTER_ACCOUNT_ID=RLxqJGUDg92

# Smoke test optional overrides
# POLYESTER_SMOKE_SYMBOL=BTC-USDT
# POLYESTER_SMOKE_CHAIN_ID=1
# POLYESTER_SMOKE_TX_HASH=0x...
# POLYESTER_SMOKE_RESOLVE_QUERY=username
# POLYESTER_SMOKE_SKIP_BUCKET_TRANSFER=1

# Optional overrides (defaults to devnet)
# POLYESTER_API_URL=https://api-devnet.polyester.ai
